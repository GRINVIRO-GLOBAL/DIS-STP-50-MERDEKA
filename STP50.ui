    /* 1. Paksa ukuran menjadi persegi (100x100) */
    min-width: 80px;
    min-height: 80px;
    max-width: 80px;
    max-height: 80px;

    /* 2. Radius harus SETENGAH dari ukuran (50px) agar jadi lingkaran */
    border-radius: 43px; 

    /* Styling Tampilan ESTOP */
    background-color: green; /* Merah */
    border: 3px solid #000000; /* Border Hitam Tebal */
    color: white;
    font-weight: bold;
    font-size: 16px;
}

/* Efek saat ditekan */
QToolButton:pressed {
    background-color: #244a2d;
    border-color: #333333;
}

/* Efek saat mouse di atas tombol (opsional) */
QToolButton:hover {
    border: 5px solid #2e4a5e; /* Border sedikit lebih terang */
}</string>
